{
  "name": "Jah - Full Stack Trading Platform",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:20-bullseye",
  "features": {
    "ghcr.io/devcontainers/features/postgres:1": {
      "version": "16"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "containerEnv": {
    "NODE_ENV": "development",
    "NODE_VERSION": "20",
    "PNPM_HOME": "/home/node/.pnpm"
  },
  "remoteEnv": {
    "PATH": "${containerEnv:PNPM_HOME}:${PATH}",
    "DATABASE_URL": "postgresql://postgres:postgres@localhost:5432/jah_dev",
    "API_PORT": "8080",
    "FRONTEND_PORT": "5173",
    "ADMIN_PORT": "3000",
    "NODE_ENV": "development"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh",
  "forwardPorts": [8080, 5173, 3000, 5432],
  "portAttributes": {
    "8080": {
      "label": "API Server",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "Frontend (Nextrade)",
      "onAutoForward": "notify"
    },
    "3000": {
      "label": "Admin Portal",
      "onAutoForward": "notify"
    },
    "5432": {
      "label": "PostgreSQL",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-vscode.vscode-typescript-next",
        "ms-vscode.makefile-tools",
        "GitHub.copilot",
        "PostgreSQL.vscode-postgresql"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      }
    }
  },
  "remoteUser": "node"
}